{
  "permissions": {
    "allow": [
      "Read(//tmp/**)",
      "Read(//private/tmp/**)",
      "Read(//opt/homebrew/**)",
      "Bash(cat *)",
      "Bash(date *)",
      "Bash(find *)",
      "Bash(grep *)",
      "Bash(mkdir -p *)",
      "Bash(ping *)",
      "Bash(python3 *)",
      "Bash(sed -n *)",
      "Bash(sips *)",
      "Bash(timeout *)",
      "Bash(./scripts/*)",
      "Bash(curl *192.168.0.20*)",
      "Bash(esphome *)",
      "Bash(gh issue *)",
      "Bash(git *)",
      "WebSearch",
      "WebFetch(domain:www.home-assistant.io)",
      "Bash(python3 -c ' *)",
      "Bash(docker compose *)",
      "Bash(ping -c1 -W2 192.168.0.20)",
      "Bash(./scripts/ha-deploy-config.sh homeassistant/packages/anchor_watch.yaml homeassistant/dashboards/helm.yaml)",
      "Bash(./scripts/ha-cli.sh core *)",
      "Bash(./scripts/ha-ssh.sh \"sudo docker exec hassio_cli ha core check\")",
      "Bash(./scripts/ha-ssh.sh \"sudo docker exec hassio_cli ha supervisor info\")",
      "Bash(./scripts/ha-ssh.sh \"sudo docker exec hassio_cli ha core check --raw-json\")",
      "Bash(./scripts/ha-ssh.sh \"sudo docker exec hassio_cli ha core restart --raw-json\")",
      "Bash(curl -s -o /dev/null -w '%{http_code}' http://192.168.0.20:8123/)",
      "Bash(git commit -m ' *)",
      "Bash(git push *)",
      "ClaudeInChromeDomain(192.168.0.21:8088)",
      "mcp__claude-in-chrome__tabs_context_mcp"
    ],
    "additionalDirectories": [
      "/Users/frikolivier/Downloads"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/scripts/claude_hook_no_secrets.py\""
          }
        ]
      }
    ]
  }
}
