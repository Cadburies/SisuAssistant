# docker-compose env for the Grafana/InfluxDB trending stack — gitignored
# real file is homeassistant/.env, generated FROM homeassistant/secrets.yaml
# (the one boat secrets file) by ./scripts/gen-docker-env.sh. Never hand-edit
# homeassistant/.env directly; re-run that script after changing the
# matching keys in secrets.yaml. This file is the committed template only.
INFLUXDB_ORG=CHANGE_ME
INFLUXDB_BUCKET=CHANGE_ME
INFLUXDB_TOKEN=CHANGE_ME
INFLUXDB_ADMIN_USER=CHANGE_ME
INFLUXDB_ADMIN_PASSWORD=CHANGE_ME
GRAFANA_ADMIN_USER=CHANGE_ME
GRAFANA_ADMIN_PASSWORD=CHANGE_ME
# Sisu Nav dated tile harvest (#80) — optional; leave CHANGE_ME/empty unless
# you actually want MapTiler/Maxar/Planet (EOX/GIBS/Esri need no key).
MAPTILER_API_KEY=CHANGE_ME
MAXAR_API_KEY=CHANGE_ME
PLANET_API_KEY=CHANGE_ME
