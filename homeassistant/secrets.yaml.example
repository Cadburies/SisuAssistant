# Copy to secrets.yaml (gitignored) — never commit that file, only this template.
# `esphome/secrets.yaml` is a symlink to this same file; one secrets file for HA + ESPHome.
#
# Sync rule: whenever a key is added/removed/renamed in the real secrets.yaml,
# this file MUST be updated in the same change — same key, placeholder value,
# and a one-line comment saying what it's for and where to get/generate it.
# Never a real value here. `./scripts/scan_secrets.sh` enforces this: it fails
# the commit if the two files' key sets don't match. See CLAUDE.md rule 4 /
# .ai_context/secrets.md.
#
# Fixed addressing this repo assumes (adjust to your own boat — see NETWORK.md):
#   Sisu LAN  192.168.0.0/24  — .20 Home Assistant, .21 TerraMaster F8 (NAS/Docker)
#   Sisu-IoT  192.168.10.0/24 — .41-.44 ESP32 boards, .30/.31 NMEA gateways, .32 Victron GX

# --- Human Wi‑Fi (phones, laptops, tablets) ---
# Your main vessel/home SSID + password, whatever you set on your router.
sisu_wifi_ssid: "Sisu"
sisu_wifi_password: "CHANGE_ME"
# Same network as sisu_wifi_* above, kept as a separate key for HA-specific
# references — set it to the same SSID/password unless you deliberately split them.
ha_wifi_ssid: "Sisu"
ha_wifi_password: "CHANGE_ME"

# --- ESP32 Wi‑Fi (2.4 GHz only — ESP32 hardware limitation) ---
# A dedicated IoT SSID on your router, isolated from/routed to your main LAN.
wifi_ssid: "Sisu-IoT"
wifi_password: "CHANGE_ME"
# Fallback AP password ESPHome broadcasts if a device can't join wifi_ssid above
# (ESPHome `ap:` block). Pick any password ≥8 chars — you choose this yourself.
ap_password: "CHANGE_ME"

# --- ESPHome OTA / API ---
# Password for pushing firmware updates over the air. You choose this yourself
# when first flashing a device (ESPHome dashboard prompts for it, or set it here first).
ota_password: "CHANGE_ME"
# Encryption key for the ESPHome native API (HA <-> device). Generate with:
#   python3 -c "import os,base64; print(base64.b64encode(os.urandom(32)).decode())"
# or let the ESPHome dashboard generate one when you create a new device (copy it here).
api_encryption_key: "CHANGE_ME"
# Freezer (LilyGo) keeps its own OTA password + API key from first flash — same
# generation method as above, just device-specific rather than shared.
freezer_ota_password: "CHANGE_ME"
freezer_api_encryption_key: "CHANGE_ME"
# Feature flag, not a secret — kept here for convenience only. "false" in production;
# only "true" on a bench wrapper deliberately running fake/simulated input data.
test_mode_enabled: "false"

# --- Home Assistant host ---
# Static LAN IP you reserve for HA via your router's DHCP reservation.
ha_host: "192.168.0.20"
# Long-lived access token for scripts/agents calling the HA REST API (optional
# — only needed for agent/script access, not for HA itself to run). Generate:
# HA UI -> Settings -> People -> your user -> Security tab -> "Long-lived access
# tokens" -> Create Token (shown once — copy immediately, cannot be viewed again).
ha_token: "CHANGE_ME"
# Your HA login (set during the first-run onboarding wizard, or Settings -> People).
ha_host_username: "Sisu"
ha_host_pwd: "CHANGE_ME"
# "Advanced SSH & Web Terminal" HA add-on credentials — set in that add-on's own
# Configuration tab after installing it from the Add-on/App Store (OPS.md §4.1).
ha_ssh_host: "192.168.0.20"
ha_ssh_port: 22
ha_ssh_user: "sisu"
ha_ssh_password: "CHANGE_ME"

# --- MQTT broker ---
# Wherever you run Mosquitto (Docker container or HA add-on). username/password
# only needed if you disable `allow_anonymous` in mosquitto.conf (see risks.md R8).
mqtt_broker: "192.168.0.21"
mqtt_username: "sisu"
mqtt_password: "CHANGE_ME"

# --- ESP32 static IPs (Sisu-IoT) ---
# Router/gateway address + subnet for the IoT SSID above.
iot_gateway: "192.168.10.1"
iot_subnet: "255.255.255.0"
# Static IP reserved per physical device (router DHCP reservation), matched to
# `manual_ip:` in each device's ESPHome YAML. Adjust the list to your own boards.
esp_ip_alt_port: "192.168.10.41"
esp_ip_alt_stbd: "192.168.10.42"
esp_ip_levels: "192.168.10.43"
esp_ip_freezer: "192.168.10.44"
esp_ip_bench: "192.168.10.49"
esp_ip_test_rig: "192.168.10.48"

# --- NMEA 2000 Wi‑Fi gateways (Sisu-IoT) — web admin + NMEA 0183 TCP ---
# Primary: Yacht Devices YDWG-02 · Failover: PredictWind DataHub.
# NMEA TCP streams themselves are unauthenticated; USERNAME/PASSWORD below are
# only for each gateway's own web admin UI (defaults printed on the device/manual
# unless changed — commonly admin/admin).
YDWG_URL: "http://192.168.10.30"
YDWG_USERNAME: "admin"
YDWG_PASSWORD: "CHANGE_ME"
ydwg_nmea_port: "1456"

PREDICTWIND_HUB_LOCAL_URL: "http://192.168.10.31"
PREDICTWIND_HUB_USERNAME: "admin"
PREDICTWIND_HUB_PASSWORD: "CHANGE_ME"
datahub_nmea_port: "11102"
# Your actual predictwind.com cloud account (optional — only if you use their
# cloud service; not used by python_scripts/nmea_gateways.py).
PREDICTWIND_USERNAME: "CHANGE_ME"
PREDICTWIND_PWD: "CHANGE_ME"

# --- Signal K server ---
# Wherever you run it (Docker container — interim Mac or eventual NAS/server,
# see OPS.md §7). SignalKUser/Pwd is the admin account Signal K prompts you to
# create the first time you open its web UI (http://<signalk_host>:3000).
signalk_host: "192.168.0.151"
signalk_port: "3000"
SignalKUser: "CHANGE_ME"
SignalKPwd: "CHANGE_ME"

# --- Grafana / InfluxDB (trending stack, same host as Signal K above) ---
# Grafana: defaults to admin/admin on first login, then force-prompts a new
# password immediately — put your chosen new password here.
GrafanaUser: "CHANGE_ME"
GrafanaPwd: "CHANGE_ME"
# InfluxDB: username/password + API token are all created during its first-run
# setup wizard (http://<signalk_host>:8086) — the token is shown once, copy
# immediately, it authenticates all reads/writes (Grafana data source, scripts).
InfluxDBUser: "CHANGE_ME"
InfluxDBPwd: "CHANGE_ME"
InfluxDB: "CHANGE_ME"
# Documents what the InfluxDB connection actually points at — org/bucket
# feed scripts/gen-docker-env.sh (Grafana datasource provisioning); host/port
# are informational only since HA 2026.9 removed YAML-configured InfluxDB
# connections (packages/trending_influxdb.yaml no longer sets host/port/
# token/org/bucket — HA auto-imported them into a UI config entry the first
# time this loaded; Settings → Devices & services → InfluxDB to change them).
# Same box as signalk_host today (interim Mac); becomes the F8 IP once #6 lands.
influxdb_host: "CHANGE_ME"
influxdb_port: "8086"
influxdb_org: "CHANGE_ME"
influxdb_bucket: "CHANGE_ME"

# --- Victron Color Control / Cerbo GX ---
# Its LAN IP — check the device's own display, your router's DHCP client list,
# or the Venus OS Remote Console. MQTT-on-LAN (Settings -> Services on the GX
# device itself) must be manually enabled before anything can read this — off
# by default, no separate secret needed once on (LAN-unauthenticated).
ColorControlIP: "192.168.10.32"

# --- Spectra Newport 400c watermaker (WS bridge) ---
# Its LAN IP (Sisu LAN, not Sisu-IoT) — check the unit's own network settings
# or your router's DHCP client list. Documentation-only today: python_scripts/
# spectra_ws.py already hardcodes this same default via SPECTRA_HOST env var
# fallback, so this key isn't consumed by any !secret reference yet.
SpectraIP: "192.168.0.25"
