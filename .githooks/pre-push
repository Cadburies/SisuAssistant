#!/usr/bin/env bash
# Block a push if any outgoing commit (message or diff) contains a real secret
# value - catches anything that slipped past pre-commit (--no-verify, other
# clones, rebases) before it becomes public (#175).
root="$(git rev-parse --show-toplevel)"
zero=0000000000000000000000000000000000000000
status=0
while read -r _lref lsha _rref rsha; do
  [[ "$lsha" == "$zero" ]] && continue                     # branch delete
  if [[ "$rsha" == "$zero" ]]; then range="$lsha --not --remotes"; else range="$rsha..$lsha"; fi
  # shellcheck disable=SC2086
  python3 "$root/scripts/secret_values.py" range $range || status=1
done
[[ $status -eq 0 ]] || echo "pre-push: blocked - an outgoing commit contains a secret value (see above)" >&2
exit $status
