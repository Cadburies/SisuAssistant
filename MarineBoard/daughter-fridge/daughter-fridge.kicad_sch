	(text "WATCHDOG\nEach HEARTBEAT rising edge holds\nWDOG_OK high ~2 s (R20 x C20, confirm).\nNo heartbeat = no relay LED supply\n= 3,500 rpm."
		(exclude_from_sim no)
		(at 76.2 17.78 0)
		(effects
			(font
				(size 1.6 1.6)
			)
			(justify left top)
		)
		(uuid "074fb7e5-6ac0-48ff-8d01-6384fc21fe8a")
	)
	(text "DRAFT 0.1 (#229). Generated from the net table,\nnot reviewed. Parts to confirm: technical spec.md 6.10."
		(exclude_from_sim no)
		(at 25.4 210.82 0)
		(effects
			(font
				(size 1.6 1.6)
			)
			(justify left top)
		)
		(uuid "18603339-96b7-4704-afd6-5fbf4f539321")
	)
	(text "LOOP SIDE\n1.5 mm from logic (kicad_dru), no GND pour.\nC - R1 - R2 - R3 - K4 - JP1 - T\nJP1 ships closed. J4 = service break."
		(exclude_from_sim no)
		(at 256.54 17.78 0)
		(effects
			(font
				(size 1.6 1.6)
			)
			(justify left top)
		)
		(uuid "27952544-45cd-44d5-b717-1848e9884038")
	)
	(text "CN4 LINK\nJST GH 10-pin, 1:1, <= 150 mm,\ninside the box.\nCheck pin 1 to pin 1."
		(exclude_from_sim no)
		(at 25.4 17.78 0)
		(effects
			(font
				(size 1.6 1.6)
			)
			(justify left top)
		)
		(uuid "762246fe-1412-42bc-a01a-383f69f9712a")
	)
	(text "SPEED + STOP\nGPIO open drain, low = LED on.\nK1 2,000 | K2 2,500 | K3 3,000 rpm\nnone on = 3,500 rpm\nK4 normally closed: on = stop."
		(exclude_from_sim no)
		(at 175.26 17.78 0)
		(effects
			(font
				(size 1.6 1.6)
			)
			(justify left top)
		)
		(uuid "b2c566a9-0828-47e9-9ded-4cd269a06857")
	)
	(text "PROBES\nSecond 1-Wire bus on GPIO9,\ntwo DS18B20, supply through F1."
		(exclude_from_sim no)
		(at 25.4 142.24 0)
		(effects
			(font
				(size 1.6 1.6)
			)
			(justify left top)
		)
		(uuid "be8df88b-cd15-4fd0-a898-14076d2aa098")
	)
	(text "FAULT INPUT\nDanfoss + and D, both ends floating.\nR16 at + limits a board fault to ~15 mA.\nFAULT_N low = lit."
		(exclude_from_sim no)
		(at 175.26 154.94 0)
		(effects
			(font
				(size 1.6 1.6)
			)
			(justify left top)
		)
		(uuid "fbb207ce-913b-4928-a47d-7fd27b2cad8f")
	)
